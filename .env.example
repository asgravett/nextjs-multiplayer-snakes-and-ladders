# Copy this file to .env.local and fill in the values.
# Variables marked (CI/CD only) are not needed locally — they are
# configured as GitHub Actions secrets for the deployment pipeline.

# ─── Redis ────────────────────────────────────────────────────────────────────

# Redis connection URL used by the Socket.IO server for state storage
# and the Redis pub/sub adapter (horizontal scaling).
# Default: redis://localhost:6379
# Production: set to your Railway Redis plugin URL or other provider.
REDIS_URL=redis://localhost:6379

# ─── Socket.IO Server ────────────────────────────────────────────────────────

# Port the standalone Socket.IO server listens on.
# Default: 4000
# Railway sets this automatically in production.
PORT=4000

# Allowed CORS origin for Socket.IO connections.
# Development: * (allow all)
# Production: set to your exact frontend URL e.g. https://yourdomain.com
# 🔴 CRITICAL: Never use * in production — restrict to your Vercel URL.
CORS_ORIGIN=*

# Heartbeat interval in ms — how often the server pings clients.
# Default: 30000 (30s)
PING_INTERVAL=30000

# Heartbeat timeout in ms — how long to wait for a pong before disconnecting.
# Default: 25000 (25s)
PING_TIMEOUT=25000

# Room TTL in seconds — stale rooms are auto-deleted from Redis after this.
# Default: 3600 (1 hour)
ROOM_TTL=3600

# ─── Rate Limiting ────────────────────────────────────────────────────────────

# Max events allowed per client per duration window.
# Default: 20
RATE_LIMIT_POINTS=20

# Duration window in seconds for the rate limiter.
# Default: 1
RATE_LIMIT_DURATION=1

# Block duration in seconds when a client exceeds the rate limit.
# Default: 5
RATE_LIMIT_BLOCK=5

# ─── Next.js Client ──────────────────────────────────────────────────────────

# URL the browser uses to connect to the Socket.IO server.
# Development: http://localhost:4000
# Production: set to your deployed Socket.IO server URL e.g. https://your-app.up.railway.app
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ─── Sentry ───────────────────────────────────────────────────────────────────

# Sentry DSN (client) — inlined into the browser bundle for client-side error reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry DSN (server/edge) — used by server and edge configs; not exposed to the browser.
SENTRY_DSN=

# Sentry auth token — required at build time for source map uploads.
# Generate at: https://sentry.io/settings/auth-tokens/
# Add to CI/CD as a secret, never commit the real value.
SENTRY_AUTH_TOKEN=

# ─── Vercel (CI/CD only) ─────────────────────────────────────────────────────

# Vercel personal access token — authenticates the Vercel CLI in GitHub Actions.
# Generate at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Vercel organisation ID — found in .vercel/project.json after running `vercel link`.
VERCEL_ORG_ID=

# Vercel project ID — found in .vercel/project.json after running `vercel link`.
VERCEL_PROJECT_ID=

# ─── Notifications (CI/CD only) ──────────────────────────────────────────────

# Discord webhook URL for CI/CD deployment notifications.
# Only used in GitHub Actions — not needed locally.
# Create at: Discord → Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
